    "sync:all": "python scraper/align_cli.py --all",
    "sync:check": "python scraper/align/check.py",
    "sync:import": "python scraper/import_taps.py",
    "test:timing": "node --test lib/timing.test.ts"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
