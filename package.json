{
  "name": "minimal-ghazal-webapp",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/timing.test.ts lib/catalog.test.ts lib/queue.test.ts",
    "test:timing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/timing.test.ts",
    "verify:data": "node scripts/verify-data.mjs",
    "check": "npm run verify:data && npm run typecheck && npm run lint && npm test && npm run build",
    "prebuild": "node scripts/verify-data.mjs",
    "harvest:audio": "python scraper/harvest_audio.py",
    "harvest:text": "python scraper/harvest_rekhta.py",
    "catalog": "python scraper/build_catalog.py",
    "align": "python scraper/align_lyrics.py",
    "sync": "python scraper/align_cli.py --report",
    "sync:one": "python scraper/align_cli.py --track",
    "sync:all": "python scraper/align_cli.py --all",
    "sync:check": "python scraper/align/check.py",
    "sync:import": "python scraper/import_taps.py"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
