{
  "name": "minimal-ghazal-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "harvest:audio": "python scraper/harvest_audio.py",
    "harvest:text": "python scraper/harvest_rekhta.py",
    "catalog": "python scraper/build_catalog.py",
    "align": "python scraper/align_lyrics.py",
    "sync": "python scraper/align_cli.py --report",
